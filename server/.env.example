# 微信小程序测试环境
WECHAT_APP_ID=your_app_id
WECHAT_APP_SECRET=your_app_secret

# 数据库
DATABASE_URL=mysql://root:your_password@localhost:3306/campus_order?charset=utf8mb4&allowPublicKeyRetrieval=true

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=12h

# 微信支付 (测试环境先用沙箱)
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=

# 服务器
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379

# 七牛云对象存储 (Kodo) - 可选，不配则用本地存储
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
QINIU_ZONE=z0

# 云打印机 — 可选，不配则仅输出日志
# 验证脚本: node test-printer.js [yilianyun|feie|shangmi]
PRINTER_YL_PARTNER=
PRINTER_YL_API_KEY=
PRINTER_YL_DEVICE_ID=
PRINTER_FEIE_USER=
PRINTER_FEIE_UKEY=
PRINTER_FEIE_DEVICE_ID=
PRINTER_SM_APP_ID=
PRINTER_SM_APP_SECRET=
PRINTER_SM_DEVICE_ID=

# OSS (SaaS模式需配，开发环境用本地存储)
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# 上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
